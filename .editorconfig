root = true

[*]
charset = utf-8
end_of_line = crlf
indent_size = 4
indent_style = space
insert_final_newline = true
max_line_length = 100
tab_width = 4

[*.java]
indent_style = tab

[*.json]
indent_size = 2
ij_json_keep_trailing_comma = false

[{*.yaml,*.yml}]
indent_size = 2

[*.md]
indent_size = 2
trim_trailing_whitespace = false

[{*.gradle,*.properties}]
trim_trailing_whitespace = true
